<Project Sdk="Microsoft.NET.Sdk">

  <!-- SEC-106: the Manager image's PDF library (Dockerfile stage "pdflib", PIM §100.61). Not code: a carrier project whose
       only job is to restore ONE pinned package + its dependency closure, LOCKED to the committed packages.lock.json
       (dotnet restore in locked mode), so a dependency can never change under the same version. Same shape as the
       `dotnet new classlib` + `dotnet add package` it replaces, so the published DLLs are the same versions.
       Change the version on purpose only: edit it here, re-run `dotnet restore` (the lock file is rewritten), commit both. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- IMAGE-PATCH-1 (2026-11-10): the transitive System.Security.Cryptography.Pkcs (8.0.1, from PDFsharp) lifted to the
         patched 8.0.2 (GHSA-846f-f764-76mx High, GHSA-2fmv-rv2c-59x7 Moderate). The vulnerable-package listing
         (dotnet list package, vulnerable, include transitive) must stay empty.
         NET10-PS76 (2026-11-10): PDFsharp-MigraDoc STAYS on 6.2.4 (its net8.0 assemblies load on .NET 10): 6.5.0, the
         only newer 6.x, refuses to render ("The loaded license is not valid.", Test-PimAsBuilt J1 on the runner).
         The Pkcs pin is KEPT and lifted to 10.0.14, the servicing level of the image's .NET 10 runtime. PDFsharp
         declares 8.0.1 (vulnerable), and the package is not part of the .NET shared framework,
         so NuGet does not prune it: without this pin the vulnerable 8.0.1 would be restored and copied into /opt/pdf.
         Inside pwsh 7.6 PowerShell's own copy (on its trusted platform assembly list) is the one that loads. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
